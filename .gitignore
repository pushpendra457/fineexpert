# ==============================================================================
# Homingo Root .gitignore
# Comprehensive ignore rules for Python, Node.js, Docker, IDEs, and Secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL: Never commit secrets)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
secrets/
private_keys/

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
venv*/
.venv/
.venv*/
ENV/
env/
env*/
ENV*/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/
.tox/
.nox/
.hypothesis/

# Linting & Type Checking
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/
.dmypy.json
dmypy.json

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# Celery & Asynchronous Tasks
celerybeat-schedule
celerybeat-schedule.*
celerybeat.pid

# ------------------------------------------------------------------------------
# Node.js & Frontend (Vue / Vite / Nuxt)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite / Build outputs
frontend/dist/
frontend/dist-ssr/
dist/
dist-ssr/
*.local
.vite/

# Frontend test coverage
coverage/

# ------------------------------------------------------------------------------
# Docker & Container Engine
# ------------------------------------------------------------------------------
.docker/
docker-compose.override.yml
*.docker.log

# ------------------------------------------------------------------------------
# Databases, Local Storage, Vector DBs
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
postgres-data/
redis-data/
qdrant_storage/
qdrant_data/
data/
uploads/
media/
storage/

# ------------------------------------------------------------------------------
# Logs & Process Artifacts
# ------------------------------------------------------------------------------
logs/
*.log
*.pid
*.seed
*.pid.lock

# ------------------------------------------------------------------------------
# Operating Systems & System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# IDEs, Code Editors & Tooling
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim & Emacs
*~
*.swp
*.swo
*.swn
.#*
\#*#

# ------------------------------------------------------------------------------
# Documentation Build Artifacts
# ------------------------------------------------------------------------------
docs/_build/
site/
