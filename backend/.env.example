# ==============================================================================
# Homingo Backend - Environment Variables Configuration
# ==============================================================================

# Application Environment: 'development', 'staging', 'production', or 'testing'
ENVIRONMENT=development

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Application Secret Key for JWT cryptography and session signing
# Generate a secure key in production using: openssl rand -hex 32
SECRET_KEY=super-secret-key-change-this-in-production-min-32-chars-for-security

# Cryptographic algorithm for JWT tokens
ALGORITHM=HS256

# JWT Token Expirations
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection URLs
# Synchronous connection URL (used for migrations and synchronous tools)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/homingo

# Asynchronous connection URL (used by FastAPI async database engine)
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/homingo

# Redis Connection URL (used for caching, rate limiting, and queues)
REDIS_URL=redis://localhost:6379/0

# Celery Background Task Broker & Result Backend
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# AI Model Provider API Keys
OPENAI_API_KEY=sk-proj-your-openai-api-key
GOOGLE_API_KEY=AIzaSy-your-gemini-api-key

# Embedding Model Identifier
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=homingo_docs

# Sentry Error Tracking DSN (leave empty to disable in local development)
SENTRY_DSN=

# CORS Allowed Origins (comma-separated strings or valid JSON list)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
